; Cat Hunter — de-risk spike (Godot 4.5)
; Throwaway project proving: CC0 rigged/animated GLB import + a follow-cam
; third-person walking controller. Not the real game repo.

config_version=5

[application]

config/name="Cat Hunter Spike"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]

; A 1600x1200 window that stays a window -- not maximized, not fullscreen -- so
; the desktop stays reachable. It is resizable, so dragging a corner is the way
; to go bigger or smaller.
window/size/viewport_width=1600
window/size/viewport_height=1200

[rendering]

; Compatibility (WebGL2 / OpenGL) is the only renderer that runs in a browser,
; so the whole project uses it — desktop and web render the same way.
renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
