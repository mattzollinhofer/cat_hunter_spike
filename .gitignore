# Godot 4 editor + import cache (regenerated on open/import)
.godot/

# Godot exports (the web build output; export_presets.cfg IS committed so CI
# can export the "Web" preset)
/build/

# macOS
.DS_Store

# Note: *.import files ARE committed on purpose — they carry per-asset import
